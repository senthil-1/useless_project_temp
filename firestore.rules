rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Citizens collection: citizens/{uid}
    match /citizens/{uid} {
      // Authenticated citizens can read their own document
      allow read: if isOwner(uid);

      // Creation upon registration: must match auth UID
      allow create: if isOwner(uid) && request.resource.data.uid == uid;

      // Updating citizen profile:
      // Citizens can update profile fields, applicationCount, uselessPoints, and rank
      // Protected fields: citizenId and citizenshipStatus cannot be altered
      allow update: if isOwner(uid)
        && (!('citizenId' in resource.data) || request.resource.data.citizenId == resource.data.citizenId)
        && (!('citizenshipStatus' in resource.data) || request.resource.data.citizenshipStatus == resource.data.citizenshipStatus);

      allow delete: if false;
    }

    // 2. Incidents collection: incidents/{incidentId}
    match /incidents/{incidentId} {
      // Citizens can read and create their own incident reports
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Allow AI assessment and status updates for the owning citizen
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    // 3. Certificate Requests: certificateRequests/{requestId}
    match /certificateRequests/{requestId} {
      // Citizens can read and create their own certificate requests
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Allow AI assessment updates for the owning citizen
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    // 4. Notifications: notifications/{notificationId}
    match /notifications/{notificationId} {
      // Users can read their own notifications and mark them as read
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // 5. Ministry Notices: notices/{noticeId}
    match /notices/{noticeId} {
      // Public notices are readable by any authenticated citizen
      allow read: if isAuthenticated();
      // Only Ministry authorized seed mechanism or console admins
      allow create, update: if isAuthenticated()
        && request.resource.data.adminSecret == "MUA-OFFICIAL-ADMIN-SECRET-2026";
      allow delete: if false;
    }
  }
}
